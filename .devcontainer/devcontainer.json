{
  "name": "Tour Management System",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "remoteUser": "node",
  "forwardPorts": [4000, 3000, 3001, 3002, 27017],
  "portsAttributes": {
    "4000": { "label": "API (backend)" },
    "3000": { "label": "Customer storefront" },
    "3001": { "label": "Admin dashboard" },
    "3002": { "label": "Tour-company dashboard" },
    "27017": { "label": "MongoDB (compose test stack)" }
  },
  "postCreateCommand": "npm run setup",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "mongodb.mongodb-vscode",
        "humao.rest-client"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "eslint.useFlatConfig": true
      }
    }
  },
  "remoteEnv": {
    "NODE_ENV": "development"
  }
}

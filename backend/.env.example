# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=4000
NODE_ENV=development

# Deployment platform flag (false for Render/Railway, true for Vercel)
IS_VERCEL=false
# Vercel sets this automatically; leave it unset elsewhere
# VERCEL=1

# Maximum accepted JSON request body (uploads have their own 5 MB limit)
JSON_BODY_LIMIT=1mb

# Log level for the structured logger: trace|debug|info|warn|error|fatal|silent
LOG_LEVEL=info

# HTTP server timeouts and graceful shutdown budget (milliseconds)
HTTP_REQUEST_TIMEOUT_MS=15000
HTTP_HEADERS_TIMEOUT_MS=20000
SHUTDOWN_TIMEOUT_MS=10000

# Optional Redis cache, idempotency store, and background queue
# REDIS_URL=redis://:password@redis.example.cache.amazonaws.com:6379
REDIS_URL=
REDIS_KEY_PREFIX=task:
REDIS_CONNECT_TIMEOUT_MS=3000

# Optional private S3 uploads. In ECS prefer an IAM task role; do not set
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY in the image or task definition.
AWS_REGION=us-east-1
# AWS_DEFAULT_REGION is accepted as a fallback by the application.
AWS_DEFAULT_REGION=
S3_BUCKET=
S3_PREFIX=uploads
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_PRESIGNED_URL_TTL_SECONDS=900

# Idempotency-Key support for mutating API requests
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_TTL_SECONDS=86400

# Optional shared token for the Prometheus endpoint. Keep it out of public
# browser builds; CloudWatch/ALB can send it through a private integration.
METRICS_TOKEN=


# ============================================
# DATABASE CONFIGURATION
# ============================================
# MongoDB Connection String
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?options
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# ============================================
# AUTHENTICATION
# ============================================
# JWT Secret Key (use a strong random string in production)
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# ============================================
# CORS CONFIGURATION
# ============================================
# Frontend URLs (for CORS). Origins are matched exactly, so no wildcards.
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
COMPANY_URL=http://localhost:3002
# Extra origins, comma separated (preview deployments, staging, ...)
CORS_EXTRA_ORIGINS=

# ============================================
# SEEDING (dangerous — local development only)
# ============================================
# The /api/seed-tours and /api/demo/create-accounts endpoints create accounts
# with known passwords. Leave this false everywhere except a throwaway local
# database.
SEED_ENABLED=false

# ============================================
# DATABASE MIGRATIONS
# ============================================
# `node scripts/run-migrations.js` applies the versioned scripts in
# scripts/migrations/ that the _migrations collection does not list yet.
# It refuses to run against a production database unless this is true.
MIGRATIONS_ENABLED=false

# ============================================
# EXTERNAL APIs
# ============================================
# Weather API Key
WEATHER_API_KEY=your_weather_api_key

# Sendinblue/Brevo API Key (for emails)
# Without it the app still boots; password-reset emails are skipped and the
# failure is logged (the endpoint still answers identically either way).
SENDINBLUE_API_KEY=your_sendinblue_api_key

# Verified sender used for transactional mail (password reset).
MAIL_FROM_NAME=Task
MAIL_FROM_EMAIL=no-reply@your-domain.example

# ============================================
# FILE UPLOAD (CLOUDINARY)
# ============================================
# Get these from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============================================
# REAL-TIME COMMUNICATION (PUSHER)
# ============================================
# Get these from: https://dashboard.pusher.com
PUSHER_APP_ID=your_app_id
PUSHER_KEY=your_key
PUSHER_SECRET=your_secret
PUSHER_CLUSTER=your_cluster

# ============================================
# DEMO / SEED ACCOUNTS (local development only)
# ============================================
# Passwords used by backend seed scripts/routes to create demo accounts.
# Never commit real values — copy this file to .env and set unique secrets there.
DEMO_USER_EMAIL=user@demo.com
DEMO_USER_PASSWORD=change-me-user
DEMO_ADMIN_EMAIL=admin@demo.com
DEMO_ADMIN_PASSWORD=change-me-admin
DEMO_COMPANY_EMAIL=company@demo.com
DEMO_COMPANY_PASSWORD=change-me-company

# ============================================
# VERCEL DEPLOYMENT
# ============================================
# NOTE: Socket.IO does NOT work on Vercel serverless functions
# For production with real-time features, deploy backend to:
# - Render (recommended): https://render.com
# - Railway: https://railway.app
# - Traditional VPS (DigitalOcean, Linode, etc.)
#
# This variable is automatically set by Vercel, don't set manually
# VERCEL=1

# ============================================
# DEPLOYMENT NOTES
# ============================================
# 
# For Render/Railway deployment:
# 1. Set IS_VERCEL=false
# 2. Update FRONTEND_URL, ADMIN_URL, COMPANY_URL with production URLs
# 3. Ensure MongoDB Atlas allows connections from 0.0.0.0/0
# 4. All file uploads will use Cloudinary (required)
# 
# For local development:
# 1. Copy this file to .env
# 2. Replace placeholder values with actual credentials
# 3. Keep localhost URLs for CORS configuration
# 4. Run: npm run validate-env (to verify configuration)
# 
# See DEPLOYMENT_GUIDE.md for complete deployment instructions
# ============================================

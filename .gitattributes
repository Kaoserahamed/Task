# Normalise line endings on checkout/commit so the repository does not churn
# between Windows and Linux contributors. Mirrors .editorconfig.
* text=auto eol=lf

*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary

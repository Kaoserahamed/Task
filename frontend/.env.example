# ============================================
# FRONTEND ENVIRONMENT CONFIGURATION
# ============================================

# Backend API URL
# Development: http://localhost:4000
# Production: https://your-backend.onrender.com
REACT_APP_API_URL=http://localhost:4000

# Optional Sentry browser monitoring. The app stays fully functional when the
# DSN is empty. Keep default PII collection disabled in src/monitoring.js.
REACT_APP_SENTRY_DSN=
# Optional immutable release identifier, e.g. task-frontend@1.0.0
REACT_APP_RELEASE=

# Demo login hint (local development only). Must match DEMO_USER_PASSWORD used
# when seeding the backend. Never commit a real password here.
REACT_APP_DEMO_USER_EMAIL=user@demo.com
REACT_APP_DEMO_USER_PASSWORD=change-me-user

# Google Places API key (optional; leave empty if unused). Both names are read;
# create-react-app only inlines REACT_APP_* at build time, so prefer that one
# when the value has to reach a production bundle.
PLACES_API_KEY=
REACT_APP_PLACES_API_KEY=

# ============================================
# DEPLOYMENT NOTES
# ============================================
# 
# For Vercel deployment:
# 1. Add this variable in Vercel dashboard (Project Settings → Environment Variables)
# 2. Set REACT_APP_API_URL to your production backend URL
# 3. Apply to: Production, Preview, and Development
# 
# For local development:
# 1. Copy this file to .env
# 2. Keep REACT_APP_API_URL=http://localhost:4000
# 3. Ensure backend is running on port 4000
# 
# ============================================

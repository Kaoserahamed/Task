{
  "name": "task-frontend",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.14.1",
  "engines": {
    "node": ">=20",
    "npm": ">=10 <12"
  },
  "dependencies": {
    "lucide-react": "^0.486.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^7.18.4",
    "socket.io-client": "^4.8.3"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "cross-env CI=false react-scripts build",
    "test": "react-scripts test",
    "test:ci": "cross-env CI=true react-scripts test --watchAll=false",
    "test:coverage": "cross-env CI=true react-scripts test --watchAll=false --coverage",
    "coverage:check": "node ../scripts/check-web-coverage.mjs",
    "lint": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint --no-eslintrc -c .eslintrc.cjs --ext .js,.jsx src",
    "lint:fix": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint --no-eslintrc -c .eslintrc.cjs --ext .js,.jsx --fix src",
    "format": "prettier --write \"src/**/*.{js,jsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css,json}\"",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test:ci && npm run build"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "react-scripts": "5.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-react-app": "^7.0.1",
    "prettier": "^3.9.8",
    "typescript": "^4.9.5"
  },
  "jest": {
    "coverageReporters": [
      "text-summary",
      "json-summary",
      "lcov",
      "clover"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/index.js",
      "!src/setupTests.js",
      "!src/**/*.test.{js,jsx}",
      "!src/Assets/**"
    ],
    "moduleNameMapper": {
      "^react-router-dom$": "<rootDir>/node_modules/react-router-dom/dist/index.js",
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js",
      "^react-router$": "<rootDir>/node_modules/react-router/dist/development/index.js"
    },
    "coverageThreshold": {
      "global": {
        "statements": 20,
        "branches": 14,
        "functions": 20,
        "lines": 20
      },
      "./src/api/": {
        "statements": 85,
        "branches": 75,
        "functions": 90,
        "lines": 85
      }
    }
  }
}

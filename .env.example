# Monorepo environment template
#
# This root file is a discoverable index for a fresh clone. The application
# processes load their own app-local templates, so copy the relevant file:
#   cp backend/.env.example backend/.env
#   cp frontend/.env.example frontend/.env
#   cp admin/.env.example admin/.env
#   cp tourcompanydashboard/.env.example tourcompanydashboard/.env
#
# Never put real credentials in this file or any committed .env file.

# Backend (see backend/.env.example for the complete contract)
MONGODB_URI=mongodb://127.0.0.1:27017/tourmate
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
COMPANY_URL=http://localhost:3002
LOG_LEVEL=info

# Optional backend integrations
REDIS_URL=
WEATHER_API_KEY=your_weather_api_key
SENDINBLUE_API_KEY=your_sendinblue_api_key
MAIL_FROM_NAME=Task
MAIL_FROM_EMAIL=no-reply@your-domain.example
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
PUSHER_APP_ID=your_app_id
PUSHER_KEY=your_key
PUSHER_SECRET=your_secret
PUSHER_CLUSTER=your_cluster

# Browser applications (all use the same local API by default)
REACT_APP_API_URL=http://localhost:4000
REACT_APP_DEMO_USER_EMAIL=user@demo.com
REACT_APP_DEMO_USER_PASSWORD=change-me-user
REACT_APP_DEMO_ADMIN_EMAIL=admin@demo.com
REACT_APP_DEMO_ADMIN_PASSWORD=change-me-admin
REACT_APP_DEMO_COMPANY_EMAIL=company@demo.com
REACT_APP_DEMO_COMPANY_PASSWORD=change-me-company

# Local-only feature flags
SEED_ENABLED=false
MIGRATIONS_ENABLED=false
WORKER_MODE=false

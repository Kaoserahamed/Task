# Monorepo environment template
#
# This root file is a discoverable index for a fresh clone. The application
# processes load their own app-local templates, so copy the relevant file:
#   cp backend/.env.example backend/.env
#   cp frontend/.env.example frontend/.env
#   cp admin/.env.example admin/.env
#   cp tourcompanydashboard/.env.example tourcompanydashboard/.env
#
# Never put real credentials in this file or any committed .env file.

# Backend runtime
PORT=4000
NODE_ENV=development
IS_VERCEL=false
JSON_BODY_LIMIT=1mb
LOG_LEVEL=info
HTTP_REQUEST_TIMEOUT_MS=15000
HTTP_HEADERS_TIMEOUT_MS=20000
SHUTDOWN_TIMEOUT_MS=10000

# Database and authentication
MONGODB_URI=mongodb://127.0.0.1:27017/tourmate
# Integration tests: leave empty to use the throwaway mongodb-memory-server, or
# point at docker-compose.test.yml (127.0.0.1:27017).
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/task-integration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d
SEED_ENABLED=false
MIGRATIONS_ENABLED=false

# CORS and request origins
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
COMPANY_URL=http://localhost:3002
CORS_EXTRA_ORIGINS=

# Redis, idempotency, and worker
REDIS_URL=
REDIS_KEY_PREFIX=task:
REDIS_CONNECT_TIMEOUT_MS=3000
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_TTL_SECONDS=86400
WORKER_MODE=false

# AWS / private S3. ECS uses an IAM role; never put static AWS keys here.
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=
S3_BUCKET=
S3_PREFIX=uploads
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_PRESIGNED_URL_TTL_SECONDS=900

# Monitoring
METRICS_TOKEN=

# Optional third-party integrations
WEATHER_API_KEY=your_weather_api_key
SENDINBLUE_API_KEY=your_sendinblue_api_key
MAIL_FROM_NAME=Task
MAIL_FROM_EMAIL=no-reply@your-domain.example
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
PUSHER_APP_ID=your_app_id
PUSHER_KEY=your_key
PUSHER_SECRET=your_secret
PUSHER_CLUSTER=your_cluster

# Local-only demo accounts. Replace before enabling seeding.
DEMO_USER_EMAIL=user@demo.com
DEMO_USER_PASSWORD=change-me-user
DEMO_ADMIN_EMAIL=admin@demo.com
DEMO_ADMIN_PASSWORD=change-me-admin
DEMO_COMPANY_EMAIL=company@demo.com
DEMO_COMPANY_PASSWORD=change-me-company

# VERCEL is injected by the hosting platform; leave it empty everywhere else.
VERCEL=

# Browser applications
REACT_APP_API_URL=http://localhost:4000
REACT_APP_PLACES_API_KEY=
PLACES_API_KEY=
REACT_APP_DEMO_USER_EMAIL=user@demo.com
REACT_APP_DEMO_USER_PASSWORD=change-me-user
REACT_APP_DEMO_ADMIN_EMAIL=admin@demo.com
REACT_APP_DEMO_ADMIN_PASSWORD=change-me-admin
REACT_APP_DEMO_COMPANY_EMAIL=company@demo.com
REACT_APP_DEMO_COMPANY_PASSWORD=change-me-company
